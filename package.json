{
  "name": "islet",
  "version": "0.0.0",
  "private": true,
  "description": "A small dynamic island for the GNOME top bar",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc && cp src/metadata.json src/stylesheet.css dist/ && mkdir -p dist/schemas && cp schemas/*.gschema.xml dist/schemas/ && glib-compile-schemas --strict dist/schemas",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:gjs": "npm run build && gjs -m tests/gjs/smoke.js",
    "lint": "eslint .",
    "pack": "npm run build && scripts/pack.sh",
    "nested": "npm run build && scripts/nested.sh",
    "install-local": "npm run build && scripts/install-local.sh",
    "nested:zip": "npm run build && scripts/nested.sh --zip"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@girs/gjs": "5.5.0",
    "@girs/gnome-shell": "50.0.4",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
